# DMARC analyzer — collect from Gmail / Google Workspace
# Usage: set these variables, then run:
#   dmarcanalyzer collect gmail --folder "DMARC" --query "has:attachment"
#   dmarcanalyzer report --period week --last 8w

# ── dmarcanalyzer ────────────────────────────────────────────────────────────
DMARCDATADIR=/var/lib/dmarcanalyzer
# DMARCDB=/var/lib/dmarcanalyzer/dmarc.db
# DMARCLOGLEVEL=INFO

# ── Gmail authentication (choose one) ────────────────────────────────────────
# Service account with domain-wide delegation (scope gmail.readonly;
# gmail.modify only when using --delete-after):
GMAILCREDENTIALS=/etc/dmarcanalyzer/service-account.json
GMAILMAILBOX=dmarc@example.com
# Or a pre-obtained bearer token:
# GMAILBEARERTOKEN=ya29...
